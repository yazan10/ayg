rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Avatars and product images - authenticated users can upload, public read
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /stores/{storeId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /reels/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /stories/{storeId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
