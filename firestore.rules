rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: is owner
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // aygram - app-wide backup documents (stores, products, users, orders, _health).
    // The app has its own local email/password auth (not Firebase Auth), so writes here
    // are never made by a signed-in Firebase user - this must stay open for the app's
    // localStorage -> Firestore backup sync to work.
    match /aygram/{docId} {
      allow read, write: if true;
    }

    // OTP / pending registration records - written by the app during signup/login,
    // never read back by clients (verification happens against local state).
    match /otps/{otpId} {
      allow read, write: if true;
    }
    match /pending_otps/{otpId} {
      allow read, write: if true;
    }

    // Users - each user can read all, write only own
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner(userId);
    }

    // Stores - public read, owner write
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.token.admin == true);
    }

    // Products - public read, store owner write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Orders - buyer or store owner
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // Conversations & Messages
    match /conversations/{conversationId} {
      allow read, write: if isSignedIn();
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.reporterId == request.auth.uid || request.auth.token.admin == true);
    }

    // Blocks
    match /blocks/{blockId} {
      allow read, write: if isSignedIn() && request.resource.data.blockedBy == request.auth.uid;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
